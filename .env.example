# ─────────────────────────────────────────────────────────────
# RAKNA LOOP — environment configuration
# Copy to .env.local. Every variable is OPTIONAL: with none set,
# the app runs in DEMO MODE with simulated Riyadh data.
# Never commit real secrets. Never prefix secrets with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# "demo" (default) = in-memory simulated data, demo account switcher.
# "supabase" = Supabase Postgres + Auth (requires the three SUPABASE vars).
RAKNA_DATA_MODE=demo

# Demo mode persists its in-memory state to .data/demo-db.json in local dev.
# Set to "off" to keep state in memory only (always off on Vercel).
RAKNA_DEMO_PERSIST=on

# ── Supabase (only for RAKNA_DATA_MODE=supabase) ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes for atomic reward functions. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: verify access tokens locally (ES256/RS256 signing keys), e.g.
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json — saves one Auth call per request.
SUPABASE_JWKS_URL=

# ── Payments (RAKNA HOME schedule bookings) ─────────────────────
# Server-only HMAC secret shared with the payment provider for POST /api/webhooks/psp.
# When set, new schedule bookings start "pending" and access unlocks only after "paid".
# When empty, bookings are SIMULATED.
RAKNA_PSP_WEBHOOK_SECRET=

# ── AI parking assistant (optional) ──────────────────────────
# Server-only. When empty, a deterministic rule-based engine is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Maps ─────────────────────────────────────────────────────
# MapLibre style URL. Empty = built-in OpenStreetMap raster style.
# For production traffic use a commercial/self-hosted tile provider
# (OSM's public tile servers are not for heavy production use).
NEXT_PUBLIC_MAP_STYLE_URL=
