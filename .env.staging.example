# ─────────────────────────────────────────────────────────────
# RAKNA LOOP — STAGING environment template.
# Use a SEPARATE Supabase project (e.g. "rakna-staging"). Never reuse production keys.
# Set these in Vercel → Project → Settings → Environment Variables → "Preview"
# (or a dedicated "staging" environment). Never commit real values.
# ─────────────────────────────────────────────────────────────

RAKNA_DATA_MODE=supabase

# Safety guard for scripts/staging-*.mjs and backfill-h3: they refuse to run unless this
# says "staging". Optionally list production project refs they must always refuse.
RAKNA_TARGET=staging
RAKNA_PRODUCTION_REFS=

# Optional: the deployed staging URL, for `npm run staging:verify` app checks.
APP_URL=

# Staging project only. The URL should identify the staging project.
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging anon key>
# Server-only. NEVER prefix with NEXT_PUBLIC_. Rotate if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY=<staging service-role key>

# Optional: leave empty in staging unless the AI path is being verified (costs money).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: commercial/self-hosted tile provider for load tests (OSM tiles are not for heavy use).
NEXT_PUBLIC_MAP_STYLE_URL=

# Demo persistence is irrelevant in supabase mode.
RAKNA_DEMO_PERSIST=off
