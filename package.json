{
  "name": "rakna-loop",
  "version": "0.1.0",
  "private": true,
  "description": "RAKNA LOOP — community parking signals, verified handoffs and RAKNA KEYS rewards (Riyadh MVP, demo mode).",
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:db": "vitest run tests/db",
    "bench": "vitest run --config vitest.bench.mts",
    "db:backfill-h3": "node --env-file=.env.staging.local scripts/backfill-h3.mjs",
    "staging:seed": "node --env-file=.env.staging.local scripts/staging-seed.mjs",
    "staging:verify": "node --env-file=.env.staging.local scripts/staging-verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@supabase/supabase-js": "2.119.0",
    "h3-js": "4.5.0",
    "lucide-react": "1.68.0",
    "maplibre-gl": "6.16.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-postgis": "0.2.15",
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.29",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
